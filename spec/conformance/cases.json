{
  "_comment": "Conformance cases for stdout NDJSON event classification (wire 0.4). Both classify_line / classifyLine MUST produce the listed object. Legacy session/text types are malformed. Optional session_id on recognised events uses the wire key name.",
  "cases": [
    {"line": "{\"type\":\"session\",\"id\":\"abc-123\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":\"abc-123\"}"}},
    {"line": "{\"type\":\"session\",\"id\":\"f47ac10b-58cc-4372\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":\"f47ac10b-58cc-4372\"}"}},
    {"line": "{\"type\":\"session\",\"id\":\"\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":\"\"}"}},
    {"line": "{\"type\":\"session\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\"}"}},
    {"line": "{\"type\":\"session\",\"id\":123}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":123}"}},
    {"line": "{\"type\":\"session\",\"id\":\"multi word id\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":\"multi word id\"}"}},
    {"line": "{\"type\":\"session\",\"id\":\"colons:and:slashes-ok\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"session\",\"id\":\"colons:and:slashes-ok\"}"}},

    {"line": "{\"type\":\"partial\",\"text\":\"hello\"}", "expect": {"kind": "partial", "value": "hello"}},
    {"line": "{\"type\":\"partial\",\"text\":\"line1\\nline2\"}", "expect": {"kind": "partial", "value": "line1\nline2"}},
    {"line": "{\"type\":\"partial\",\"text\":\"\"}", "expect": {"kind": "partial", "value": ""}},
    {"line": "{\"type\":\"partial\"}", "expect": {"kind": "partial", "value": ""}},
    {"line": "{\"type\":\"partial\",\"text\":42}", "expect": {"kind": "partial", "value": ""}},
    {"line": "{\"type\":\"partial\",\"text\":\"unicode 你好 🚀\"}", "expect": {"kind": "partial", "value": "unicode 你好 🚀"}},
    {"line": "{\"type\":\"partial\",\"text\":\"x\",\"role\":\"thinking\"}", "expect": {"kind": "partial", "value": "x", "role": "thinking"}},
    {"line": "{\"type\":\"partial\",\"text\":\"y\",\"role\":42}", "expect": {"kind": "partial", "value": "y"}},
    {"line": "{\"type\":\"partial\",\"text\":\"z\",\"session_id\":\"sess-1\"}", "expect": {"kind": "partial", "value": "z", "session_id": "sess-1"}},

    {"line": "{\"type\":\"text\",\"text\":\"hello world\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"text\",\"text\":\"hello world\"}"}},
    {"line": "{\"type\":\"text\",\"text\":\"\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"text\",\"text\":\"\"}"}},
    {"line": "{\"type\":\"text\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"text\"}"}},
    {"line": "{\"type\":\"text\",\"text\":true}", "expect": {"kind": "malformed", "value": "{\"type\":\"text\",\"text\":true}"}},

    {"line": "{\"type\":\"result\",\"text\":\"hello world\"}", "expect": {"kind": "result", "value": "hello world"}},
    {"line": "{\"type\":\"result\",\"text\":\"\"}", "expect": {"kind": "result", "value": ""}},
    {"line": "{\"type\":\"result\"}", "expect": {"kind": "result", "value": ""}},
    {"line": "{\"type\":\"result\",\"text\":true}", "expect": {"kind": "result", "value": ""}},
    {"line": "{\"type\":\"result\",\"text\":\"ok\",\"session_id\":\"s1\"}", "expect": {"kind": "result", "value": "ok", "session_id": "s1"}},

    {"line": "{\"type\":\"error\",\"message\":\"rate limited\"}", "expect": {"kind": "error", "value": "rate limited"}},
    {"line": "{\"type\":\"error\",\"message\":\"\"}", "expect": {"kind": "error", "value": ""}},
    {"line": "{\"type\":\"error\"}", "expect": {"kind": "error", "value": ""}},
    {"line": "{\"type\":\"error\",\"message\":true}", "expect": {"kind": "error", "value": ""}},
    {"line": "{\"type\":\"error\",\"message\":\"boom\",\"session_id\":\"s-err\"}", "expect": {"kind": "error", "value": "boom", "session_id": "s-err"}},

    {"line": "{\"type\":\"permission_request\",\"request_id\":\"1\",\"tool_name\":\"Bash\",\"input\":{}}", "expect": {"kind": "permission_request", "value": {"type": "permission_request", "request_id": "1", "tool_name": "Bash", "input": {}}}},
    {"line": "{\"type\":\"permission_request\",\"request_id\":\"2\",\"tool_name\":\"WebFetch\",\"input\":{\"url\":\"https://x\"}}", "expect": {"kind": "permission_request", "value": {"type": "permission_request", "request_id": "2", "tool_name": "WebFetch", "input": {"url": "https://x"}}}},

    {"line": "hello world", "expect": {"kind": "malformed", "value": "hello world"}},
    {"line": "", "expect": {"kind": "malformed", "value": ""}},
    {"line": "not json", "expect": {"kind": "malformed", "value": "not json"}},
    {"line": "42", "expect": {"kind": "malformed", "value": "42"}},
    {"line": "[1,2,3]", "expect": {"kind": "malformed", "value": "[1,2,3]"}},
    {"line": "{\"foo\":\"bar\"}", "expect": {"kind": "malformed", "value": "{\"foo\":\"bar\"}"}},
    {"line": "{\"type\":\"unknown\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"unknown\"}"}},
    {"line": "{\"type\":\"SESSION\",\"id\":\"x\"}", "expect": {"kind": "malformed", "value": "{\"type\":\"SESSION\",\"id\":\"x\"}"}}
  ],
  "env_compose": [
    {
      "_comment": "Child-env composition. Both _compose_env / composeEnv MUST build infra set + profile env (${VAR} expanded, env_allowlist filtered — blocked names expand to empty string but the key is still set) + extra_env (later layers override earlier). `host_env` fakes the bridge environment (also the source the infra set is copied from). `expect_contains` = exact key/value pairs that MUST be present; `expect_absent` = names that MUST NOT appear at all.",
      "profile_env": {"DECLARED": "${ALLOWED}", "BLOCKED": "${SECRET}", "LITERAL": "lit-val"},
      "env_allowlist": ["ALLOWED"],
      "extra_env": {"EXTRA_FLAG": "extra-val", "DECLARED": "overridden"},
      "host_env": {"ALLOWED": "ok-val", "SECRET": "top-secret", "PATH": "/usr/bin:/bin", "HOME": "/home/u"},
      "expect_contains": {"DECLARED": "overridden", "LITERAL": "lit-val", "EXTRA_FLAG": "extra-val", "PATH": "/usr/bin:/bin", "HOME": "/home/u", "BLOCKED": ""},
      "expect_absent": ["SECRET"]
    }
  ],
  "auto_approve_flags": ["--dangerously-skip-permissions", "--yolo", "--always-approve", "--yes-always", "--approve", "--auto"],
  "posture_cases": [
    {"name": "claude-code + permission:true uses the approval channel", "executor": "claude-code", "permission": true, "env": {},
     "expect": {"error": false, "exit_zero": true, "reply": "ok",
                "argv_contains": ["--permission-prompt-tool", "stdio"],
                "argv_excludes": ["--dangerously-skip-permissions"]}},
    {"name": "claude-code without permission stays unattended", "executor": "claude-code", "env": {},
     "expect": {"exit_zero": true,
                "argv_contains": ["--dangerously-skip-permissions"],
                "argv_excludes": ["--permission-prompt-tool"]}},

    {"name": "codebuddy has no permission channel", "executor": "codebuddy", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--dangerously-skip-permissions"]}},
    {"name": "cursor has no permission channel", "executor": "cursor", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--yolo"]}},
    {"name": "gemini-cli has no permission channel", "executor": "gemini-cli", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--yolo"]}},
    {"name": "grok-build has no permission channel", "executor": "grok-build", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--always-approve"]}},
    {"name": "opencode has no permission channel", "executor": "opencode", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--auto"]}},
    {"name": "qwen-code has no permission channel", "executor": "qwen-code", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--yolo"]}},
    {"name": "agy has no permission channel", "executor": "agy", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--dangerously-skip-permissions"]}},
    {"name": "aider has no permission channel", "executor": "aider", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--yes-always"]}},
    {"name": "pi has no permission channel", "executor": "pi", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--approve"]}},
    {"name": "codex has no permission channel", "executor": "codex", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": []}},
    {"name": "kimi-code has no permission channel", "executor": "kimi-code", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": []}},
    {"name": "deepseek has no permission channel", "executor": "deepseek", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": []}},
    {"name": "dsh has no permission channel", "executor": "dsh", "permission": true, "env": {},
     "expect": {"error": true, "refused": true, "argv_excludes": []}},

    {"name": "AGENTPROC_AUTO_APPROVE=0 refuses claude-code skip-permissions", "executor": "claude-code",
     "env": {"AGENTPROC_AUTO_APPROVE": "0"},
     "expect": {"error": true, "refused": true,
                "argv_excludes": ["--dangerously-skip-permissions", "--yolo", "--always-approve", "--yes-always", "--approve", "--auto"]}},
    {"name": "AGENTPROC_AUTO_APPROVE=0 refuses gemini-cli --yolo", "executor": "gemini-cli",
     "env": {"AGENTPROC_AUTO_APPROVE": "0"},
     "expect": {"error": true, "refused": true, "argv_excludes": ["--yolo"]}},
    {"name": "AGENTPROC_AUTO_APPROVE=0 still allows the approval channel", "executor": "claude-code", "permission": true,
     "env": {"AGENTPROC_AUTO_APPROVE": "0"},
     "expect": {"error": false, "exit_zero": true, "reply": "ok",
                "argv_contains": ["--permission-prompt-tool", "stdio"],
                "argv_excludes": ["--dangerously-skip-permissions", "--yolo", "--always-approve", "--yes-always", "--approve", "--auto"]}}
  ]
}
